{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/harmony-agent-tools/scenario.schema.json",
  "title": "Harmony Device Scenario",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target": {
      "type": "string"
    },
    "outputDirectory": {
      "type": "string",
      "default": "artifacts"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/tap"
          },
          {
            "$ref": "#/$defs/swipe"
          },
          {
            "$ref": "#/$defs/wait"
          },
          {
            "$ref": "#/$defs/screenshot"
          },
          {
            "$ref": "#/$defs/gestureCapture"
          }
        ]
      }
    }
  },
  "required": [
    "steps"
  ],
  "$defs": {
    "timedStep": {
      "type": "object",
      "properties": {
        "atMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tap": {
      "allOf": [
        {
          "$ref": "#/$defs/timedStep"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "tap"
            },
            "atMs": {
              "type": "integer",
              "minimum": 0
            },
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "pressMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 450,
              "default": 100
            }
          },
          "required": [
            "action",
            "x",
            "y"
          ]
        }
      ]
    },
    "swipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "swipe"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "startX": {
          "type": "integer"
        },
        "startY": {
          "type": "integer"
        },
        "endX": {
          "type": "integer"
        },
        "endY": {
          "type": "integer"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000,
          "default": 300
        },
        "keepMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "default": 0
        }
      },
      "required": [
        "action",
        "startX",
        "startY",
        "endX",
        "endY"
      ]
    },
    "wait": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "wait"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "milliseconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "action",
        "milliseconds"
      ]
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "screenshot"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    },
    "gestureCapture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "gestureCapture"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "startX": {
          "type": "integer"
        },
        "startY": {
          "type": "integer"
        },
        "endX": {
          "type": "integer"
        },
        "endY": {
          "type": "integer"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000,
          "default": 300
        },
        "keepMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "default": 0
        },
        "captureAtMs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "prefix": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "startX",
        "startY",
        "endX",
        "endY",
        "captureAtMs"
      ]
    }
  }
}
